// Cloudflare Worker serving veridact.net as static files (Workers Free plan: static requests are free and unlimited).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veridact-net",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // Routes are added at cutover, after checking the site at veridact-net.<subdomain>.workers.dev.
}
