// Cloudflare Worker serving veridact.net as static files (Workers Free plan: static requests are free and unlimited).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veridact-net",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // All of veridact.net is served by this Worker. The proxied DNS records still point at the old Hetzner
  // host; removing these routes falls back to it.
  // Workers Builds runs `wrangler preview` for branches and pull requests; it needs this block.
  // Previews get their own workers.dev URL and never take over the routes below.
  "previews": {},
  "routes": [
    { "pattern": "veridact.net/*", "zone_name": "veridact.net" },
    { "pattern": "www.veridact.net/*", "zone_name": "veridact.net" }
  ]
}
